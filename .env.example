# ============================
# 배포 환경 설정
# ============================
# 이 파일은 .gitignore에 등록되어 있어 Git에 커밋되지 않습니다.
# 배포 서버에 직접 생성하거나 환경 변수로 설정해주세요.

# ============================
# 필수 설정 - 학사 일정 크롤링
# ============================
SEJONG_PORTAL_ID=your_portal_id
SEJONG_PORTAL_PASSWORD=your_portal_password

# ============================
# 선택적 설정 - AI 분류 기능
# ============================
OPENAI_API_KEY=sk-...

# ============================
# 프로필 설정
# ============================
# dev: H2 인메모리 DB (개발 환경)
# prod: PostgreSQL 실제 DB (프로덕션)
SPRING_PROFILES_ACTIVE=prod

# ============================
# 프로덕션 데이터베이스 설정
# ============================
DB_URL=jdbc:postgresql://localhost:5432/doogoo
DB_USERNAME=doogoo_user
DB_PASSWORD=your_db_password

# ============================
# CORS 설정 (프로덕션)
# ============================
# 쉼표로 구분하여 여러 도메인 지정
# 개발 환경: * (모든 도메인 허용)
# 프로덕션: https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================
# 로깅 설정 (선택적)
# ============================
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_DOOGOO=DEBUG

